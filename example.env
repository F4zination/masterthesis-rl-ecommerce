# Copy this file to `.env` and replace every placeholder before deployment.
# Used by Docker Compose and the TLS bootstrap scripts under deploy/.

# Public domains (each needs a DNS A/AAAA record pointing to this host).
# The apex host redirects to the dispatcher while preserving path and query.
APEX_DOMAIN=thedemoshop.live
DISPATCHER_DOMAIN=start.thedemoshop.live
V2_DOMAIN=v2.thedemoshop.live
V3_DOMAIN=v3.thedemoshop.live

# Let's Encrypt
# Address used only for certificate expiry and renewal notices.
CERTBOT_EMAIL=you@example.com
# Use 1 for testing with the Let's Encrypt staging CA, then 0 for production.
CERTBOT_STAGING=1

# Dispatcher
# Per-cell recruitment target (2 conditions x 5 personas = 10 cells).
TARGET_PER_CELL=30
# Personas actually recruited (comma-separated subset of the five scenarios).
# The August 2026 convenience-sample design assigns only these three cells;
# the other two scenarios stay deployed and digest-locked but unassigned.
STUDY_PERSONAS=fastbuyer,detailedcomparator,windowshopper
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-with-a-long-random-token
# Browser login used for the dispatcher and both protected condition dashboards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-long-random-password
# HMAC key for the shared login cookie. Generate independently with the command above.
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
# Leading dot shares the secure, HttpOnly login cookie with start/v2/v3.
ADMIN_COOKIE_DOMAIN=.thedemoshop.live
ADMIN_COOKIE_NAME=study_admin_session
ADMIN_COOKIE_SECURE=true
# Eight hours.
ADMIN_SESSION_TTL_SECONDS=28800
# Optional participant destination when every cell is full. Leave empty if unused.
STUDY_FULL_URL=

# Required legal and study information
# Confirm with your supervisor or university who is the GDPR controller.
STUDY_RESEARCHER_NAME=Your name
STUDY_INSTITUTION=Your institution
LEGAL_CONTROLLER_NAME=Controller name
LEGAL_CONTROLLER_ADDRESS=Street 1, 12345 City, Germany
LEGAL_CONTROLLER_EMAIL=privacy@example.com
# Optional direct telephone number and separate content-responsible person.
LEGAL_CONTROLLER_PHONE=
LEGAL_CONTENT_RESPONSIBLE=Responsible person
# If applicable: legal form/representative, register and number, VAT ID,
# professional rules, or competent supervisory authority.
LEGAL_ADDITIONAL_IMPRINT_DETAILS=
# Data-protection officer/contact, if applicable.
LEGAL_DATA_PROTECTION_CONTACT=
# Name and address of the server or hosting provider.
LEGAL_HOSTING_PROVIDER=Hosting provider name and address
# Concrete period or criterion for study-data retention.
STUDY_RETENTION_PERIOD=Replace with the applicable retention period
# Retention period for nginx/application access and security logs.
SERVER_LOG_RETENTION_PERIOD=Replace with the applicable log retention period
# State whether third-country transfers occur and identify any safeguards,
# particularly for externally hosted resources such as the jsDelivr CDN.
LEGAL_THIRD_COUNTRY_INFORMATION=Replace with the applicable transfer information
