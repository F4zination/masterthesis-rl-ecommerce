# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. ${APEX_DOMAIN}, ${DISPATCHER_DOMAIN},
# ${V2_DOMAIN}, and ${V3_DOMAIN} are substituted (they are passed as env vars);
# nginx runtime variables such as $host / $request_uri are left untouched.
#
# Each domain gets a port-80 block (serves the ACME http-01 challenge and
# redirects everything else to https) and a port-443 TLS block that
# reverse-proxies to the matching service on the internal Docker network.

# Apex domain (canonical-host redirect)
server {
    listen 80;
    listen [::]:80;
    server_name ${APEX_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${DISPATCHER_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APEX_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APEX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APEX_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://${DISPATCHER_DOMAIN}$request_uri;
}

# ── Dispatcher (assignment + redirect) ──────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DISPATCHER_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DISPATCHER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DISPATCHER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DISPATCHER_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── DemoSiteV2 (Contextual Bandit) ──────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${V2_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${V2_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${V2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${V2_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Keep mandatory legal information reachable from every study page/domain.
    location ~ ^/(imprint|privacy|participant-information)$ {
        proxy_pass http://dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Product imagery dominates page weight and is content-stable for the run
    # of the study. Without this the app sends only ETag/Last-Modified, so
    # every navigation re-validates every image over the wire.
    location /static/images/ {
        proxy_pass http://v2:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location / {
        proxy_pass http://v2:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── DemoSiteV3 (PPO / sequential RL) ────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${V3_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${V3_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${V3_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${V3_DOMAIN}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Keep mandatory legal information reachable from every study page/domain.
    location ~ ^/(imprint|privacy|participant-information)$ {
        proxy_pass http://dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # See the V2 block: cache the heaviest asset class rather than
    # re-validating every product image on every navigation.
    location /static/images/ {
        proxy_pass http://v3:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location / {
        proxy_pass http://v3:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
