# Rendered by the official nginx entrypoint in the MaglioSite nginx container.
# One SAN certificate covers all four study hostnames.

server {
    listen 80;
    listen [::]:80;
    server_name ${APEX_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DISPATCHER_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DISPATCHER_DOMAIN} ${V2_DOMAIN} ${V3_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APEX_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://${DISPATCHER_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DISPATCHER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://study-dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${V2_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location ~ ^/(imprint|privacy|participant-information)$ {
        proxy_pass http://study-dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://study-v2:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${V3_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STUDY_CERTIFICATE_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location ~ ^/(imprint|privacy|participant-information)$ {
        proxy_pass http://study-dispatcher:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://study-v3:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
